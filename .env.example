# StuddyBuddy does NOT read API keys from the environment or .env files.
# Keys are entered in-app (Settings → AI Providers) and stored encrypted in
# the local secrets vault (OS keychain via Electron safeStorage when
# available, AES-256-GCM key file otherwise). This file exists only to
# document optional development variables.

# Speed multiplier for the bundled demo lecture playback (dev convenience).
# SB_DEMO_SPEED=5

# Force a data directory (defaults to the OS app-data location).
# SB_DATA_DIR=./.studdybuddy-data
